[Unit]
Description=FestVisuals Jarvis voice server
After=network.target

[Service]
Type=simple
User=festvisuals
WorkingDirectory=/opt/festvisuals-jarvis
EnvironmentFile=/opt/festvisuals-jarvis/.env
ExecStart=/opt/festvisuals-jarvis/venv/bin/python server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
