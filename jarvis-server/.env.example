# Copy this to .env and fill in.

# Free key from https://console.groq.com/keys — only used for utterances that don't
# match a known Minecraft command (home/spawn/auction/module toggle/dictation).
GROQ_API_KEY=

# llama-3.1-8b-instant is faster; llama-3.3-70b-versatile (default) is smarter.
GROQ_MODEL=llama-3.3-70b-versatile

# tiny/base/small/medium — bigger is slower and more accurate. small is a good CPU default.
WHISPER_MODEL=small
WHISPER_COMPUTE=int8
WHISPER_LANGUAGE=ru

# Piper TTS. See README for how to fetch the binary and a Russian voice.
PIPER_BIN=./piper/piper
PIPER_VOICE=./piper/ru_RU-irina-medium.onnx

JARVIS_HOST=0.0.0.0
JARVIS_PORT=8765

# Shared secret the client must send — set this if the port is reachable from the
# open internet, otherwise anyone who finds it can trigger chat/commands as you.
JARVIS_TOKEN=
