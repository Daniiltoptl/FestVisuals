{
	"schemaVersion": 1,
    "accessWidener": "festvisuals.accesswidener",
	"id": "festvisuals",
	"version": "${version}",
	"name": "FestVisuals",
	"description": "Client-side visual overlays and HUD widgets for Minecraft",
	"authors": [
		"FestVisuals"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/festvisuals/icon.png",
	"environment": "client",
	"entrypoints": {
		"preLaunch": [
			"com.fest.visuals.FestPreLaunch"
		],
		"client": [
			"com.fest.visuals.FestVisuals"
		]
	},
	"mixins": [
		"festvisuals.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.17.0",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}
